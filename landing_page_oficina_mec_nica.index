  <!-- JAVASCRIPT DE LÓGICA E INTERAÇÕES -->
  <script>
    document.addEventListener("DOMContentLoaded", function() {
      
      // Atualizar ano dinamicamente no footer
      document.getElementById("year").innerText = new Date().getFullYear();

      // Atualizar dados do objeto de configuração na página
      document.getElementById("info-endereco").innerText = CONFIG_OFICINA.endereco;
      document.getElementById("info-telefone").innerText = CONFIG_OFICINA.telefone;
      document.getElementById("info-semana").innerText = CONFIG_OFICINA.horarioSemana;
      document.getElementById("info-sabado").innerText = CONFIG_OFICINA.horarioSabado;

      // URL base do WhatsApp para conversa direta
      const whatsUrlBase = `https://wa.me/${CONFIG_OFICINA.whatsappNumber}?text=${encodeURIComponent("Olá! Gostaria de obter informações sobre os serviços da oficina.")}`;
      
      document.getElementById("whatsapp-floating-btn").href = whatsUrlBase;
      document.getElementById("btn-whats-contato").href = whatsUrlBase;
      document.getElementById("btn-maps").href = `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(CONFIG_OFICINA.endereco)}`;
      document.getElementById("btn-ligar").href = `tel:${CONFIG_OFICINA.whatsappNumber}`;

      // Configuração do Google Maps Embed sem necessidade de API Key
      const googleMapsEmbedUrl = `https://maps.google.com/maps?q=${encodeURIComponent(CONFIG_OFICINA.endereco)}&t=&z=15&ie=UTF8&iwloc=&output=embed`;
      document.getElementById("google-maps-embed").src = googleMapsEmbedUrl;

      // Mobile Menu
      const menuBtn = document.getElementById("mobile-menu-btn");
      const mobileMenu = document.getElementById("mobile-menu");
      const mobileLinks = document.querySelectorAll(".mobile-link");

      menuBtn.addEventListener("click", () => {
        mobileMenu.classList.toggle("hidden");
      });

      mobileLinks.forEach(link => {
        link.addEventListener("click", () => {
          mobileMenu.classList.add("hidden");
        });
      });
    });

    // Função para preencher serviço selecionado no formulário
    function preencherServico(nomeServico) {
      const select = document.getElementById("servico_desejado");
      if (select) {
        select.value = nomeServico;
      }
    }

    // Função de envio de dados para o WhatsApp
    function enviarOrcamentoWhatsApp(event) {
      event.preventDefault();

      const nome = document.getElementById("cliente_nome").value.trim();
      const telefone = document.getElementById("cliente_telefone").value.trim();
      const modelo = document.getElementById("veiculo_modelo").value.trim();
      const ano = document.getElementById("veiculo_ano").value.trim();
      const servico = document.getElementById("servico_desejado").value;
      const descricao = document.getElementById("problema_descricao").value.trim();

      let mensagem = `*SOLICITAÇÃO DE ORÇAMENTO - WEBSITE*\n\n`;
      mensagem += `*Cliente:* ${nome}\n`;
      mensagem += `*Telefone:* ${telefone}\n`;
      mensagem += `*Veículo:* ${modelo} (${ano})\n`;
      mensagem += `*Serviço Desejado:* ${servico}\n`;
      if (descricao) {
        mensagem += `*Observações:* ${descricao}\n`;
      }

      const urlWhatsApp = `https://wa.me/${CONFIG_OFICINA.whatsappNumber}?text=${encodeURIComponent(mensagem)}`;
      window.open(urlWhatsApp, '_blank');
    }

    // Modal Lightbox da Galeria
    function openLightbox(imageUrl) {
      const lightbox = document.getElementById("lightbox");
      const lightboxImg = document.getElementById("lightbox-img");
      lightboxImg.src = imageUrl;
      lightbox.classList.remove("hidden");
    }

    function closeLightbox() {
      const lightbox = document.getElementById("lightbox");
      lightbox.classList.add("hidden");
    }
  </script>
</body>
</html>
