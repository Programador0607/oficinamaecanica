            </a>
            <a id="btn-whats-contato" href="#" target="_blank" class="text-white bg-green-600 hover:bg-green-700 px-4 py-2.5 rounded-lg text-xs font-bold flex items-center gap-2">
              <i class="fa-brands fa-whatsapp"></i> WhatsApp
            </a>
          </div>
        </div>

        <!-- Horário -->
        <div class="bg-brand-black p-8 rounded-2xl border border-gray-800 flex flex-col justify-between">
          <div>
            <div class="w-12 h-12 bg-brand-red/10 text-brand-red rounded-xl flex items-center justify-center text-xl mb-6">
              <i class="fa-solid fa-clock"></i>
            </div>
            <h3 class="text-lg font-bold text-white mb-2">Horário de Funcionamento</h3>
            <p id="info-semana" class="text-gray-400 text-sm mb-1"></p>
            <p id="info-sabado" class="text-gray-400 text-sm mb-6"></p>
          </div>
          <span class="text-xs text-green-500 font-semibold flex items-center gap-2">
            <span class="w-2 h-2 rounded-full bg-green-500 animate-pulse"></span> Atendimento em horário comercial
          </span>
        </div>

      </div>

      <!-- MAPA DO GOOGLE INCORPORADO (SEM DEPENDÊNCIA DE API KEY) -->
      <div class="w-full h-96 rounded-2xl overflow-hidden border border-gray-800 shadow-xl relative bg-brand-black">
