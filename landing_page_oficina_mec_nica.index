  <!-- 7. FORMULÁRIO DE ORÇAMENTO WHATSAPP -->
  <section id="orcamento" class="py-24 bg-brand-black relative">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
        
        <div class="lg:col-span-5">
          <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-green-500/10 border border-green-500/30 text-green-500 text-xs font-semibold mb-4">
            <i class="fa-solid fa-bolt"></i> Resposta pelo WhatsApp
          </div>
          <h2 class="text-3xl sm:text-4xl font-extrabold text-white mb-6">Solicite seu Orçamento sem Compromisso</h2>
          <p class="text-gray-300 text-base leading-relaxed mb-8">
            Preencha os dados do seu veículo e o serviço desejado. As informações serão organizadas e enviadas diretamente para a conversa do nosso WhatsApp.
          </p>

          <div class="space-y-4">
            <div class="flex items-center gap-3 text-gray-300 text-sm">
              <i class="fa-solid fa-circle-check text-brand-red"></i> Sem burocracia ou formulários extensos
            </div>
            <div class="flex items-center gap-3 text-gray-300 text-sm">
              <i class="fa-solid fa-circle-check text-brand-red"></i> Informações claras sobre peças e serviços
            </div>
            <div class="flex items-center gap-3 text-gray-300 text-sm">
              <i class="fa-solid fa-circle-check text-brand-red"></i> Resposta rápida diretamente da equipe técnica
            </div>
          </div>
        </div>

        <div class="lg:col-span-7 bg-brand-card p-6 sm:p-10 rounded-3xl border border-gray-800 shadow-2xl">
          <form id="whatsappForm" onsubmit="enviarOrcamentoWhatsApp(event)" class="space-y-4">
            
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <div>
                <label for="cliente_nome" class="block text-xs font-bold uppercase text-gray-400 mb-2">Seu Nome *</label>
                <input type="text" id="cliente_nome" required placeholder="Ex: Carlos Silva" class="w-full bg-brand-black border border-gray-700 rounded-xl px-4 py-3 text-white placeholder-gray-500 focus:outline-none focus:border-brand-red text-sm">
              </div>
              <div>
                <label for="cliente_telefone" class="block text-xs font-bold uppercase text-gray-400 mb-2">Telefone / WhatsApp *</label>
                <input type="tel" id="cliente_telefone" required placeholder="Ex: (11) 99999-9999" class="w-full bg-brand-black border border-gray-700 rounded-xl px-4 py-3 text-white placeholder-gray-500 focus:outline-none focus:border-brand-red text-sm">
              </div>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <div>
                <label for="veiculo_modelo" class="block text-xs font-bold uppercase text-gray-400 mb-2">Modelo do Veículo *</label>
                <input type="text" id="veiculo_modelo" required placeholder="Ex: Honda Civic 2.0" class="w-full bg-brand-black border border-gray-700 rounded-xl px-4 py-3 text-white placeholder-gray-500 focus:outline-none focus:border-brand-red text-sm">
              </div>
              <div>
                <label for="veiculo_ano" class="block text-xs font-bold uppercase text-gray-400 mb-2">Ano do Veículo *</label>
                <input type="text" id="veiculo_ano" required placeholder="Ex: 2020" class="w-full bg-brand-black border border-gray-700 rounded-xl px-4 py-3 text-white placeholder-gray-500 focus:outline-none focus:border-brand-red text-sm">
              </div>
            </div>

            <div>
              <label for="servico_desejado" class="block text-xs font-bold uppercase text-gray-400 mb-2">Serviço Desejado *</label>
              <select id="servico_desejado" required class="w-full bg-brand-black border border-gray-700 rounded-xl px-4 py-3 text-white focus:outline-none focus:border-brand-red text-sm">
                <option value="" disabled selected>Selecione o serviço...</option>
                <option value="Revisão Preventiva">Revisão Preventiva</option>
                <option value="Troca de Óleo e Filtros">Troca de Óleo e Filtros</option>
                <option value="Diagnóstico Eletrônico">Diagnóstico Eletrônico</option>
                <option value="Manutenção de Freios">Manutenção de Freios</option>
                <option value="Suspensão e Direção">Suspensão e Direção</option>
                <option value="Manutenção de Motores">Manutenção de Motores</option>
                <option value="Sistema de Arrefecimento">Sistema de Arrefecimento</option>
                <option value="Mecânica Geral">Serviços de Mecânica Geral</option>
              </select>
            </div>

            <div>
              <label for="problema_descricao" class="block text-xs font-bold uppercase text-gray-400 mb-2">Descrição do Problema ou Observações</label>
              <textarea id="problema_descricao" rows="3" placeholder="Descreva ruídos, luzes acesas no painel ou outras observações..." class="w-full bg-brand-black border border-gray-700 rounded-xl px-4 py-3 text-white placeholder-gray-500 focus:outline-none focus:border-brand-red text-sm"></textarea>
            </div>

            <button type="submit" class="w-full bg-green-600 hover:bg-green-700 text-white font-bold py-4 rounded-xl transition-all shadow-lg shadow-green-950/40 flex items-center justify-center gap-3 text-base">
              <i class="fa-brands fa-whatsapp text-2xl"></i>
              Enviar Orçamento pelo WhatsApp
            </button>
          </form>
        </div>

      </div>

    </div>
  </section>

