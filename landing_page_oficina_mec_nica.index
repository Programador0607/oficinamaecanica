  <!-- BOTÃO FLUTUANTE DO WHATSAPP -->
  <div class="fixed bottom-6 right-6 z-50">
    <a id="whatsapp-floating-btn" href="#" target="_blank" aria-label="Falar pelo WhatsApp" 
       class="relative group w-14 h-14 bg-green-500 text-white rounded-full flex items-center justify-center text-3xl shadow-2xl hover:bg-green-600 transition-transform transform hover:scale-110">
      <span class="absolute inset-0 rounded-full bg-green-500 whatsapp-pulse pointer-events-none"></span>
      <i class="fa-brands fa-whatsapp relative z-10"></i>
    </a>
