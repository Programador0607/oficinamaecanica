<!DOCTYPE html>
<html lang="pt-BR" class="scroll-smooth">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>AutoTech - Centro Automotivo & Oficina Mecânica</title>
  
  <!-- Tailwind CSS CDN -->
  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = {
      theme: {
        extend: {
          colors: {
            brand: {
              black: '#121212',
              dark: '#1A1A1A',
              card: '#242424',
              border: '#333333',
              red: '#DC2626',
              redHover: '#B91C1C',
              silver: '#9CA3AF'
            }
          },
          fontFamily: {
            sans: ['Inter', 'sans-serif']
          }
        }
      }
    }
  </script>

  <!-- Google Fonts & Font Awesome Icons -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

  <style>
    body {
      font-family: 'Inter', sans-serif;
      background-color: #121212;
      color: #F3F4F6;
    }
    
    .glass-nav {
      background: rgba(18, 18, 18, 0.9);
      backdrop-filter: blur(12px);
      -webkit-backdrop-filter: blur(12px);
    }
    
    .glass-card {
      background: rgba(30, 30, 30, 0.7);
      backdrop-filter: blur(8px);
      border: 1px solid rgba(255, 255, 255, 0.08);
    }

    .glass-card:hover {
      border-color: rgba(220, 38, 38, 0.4);
      transform: translateY(-4px);
    }

    /* Pulso no botão do WhatsApp */
    @keyframes pulse-ring {
      0% { transform: scale(0.95); opacity: 0.8; }
      50% { transform: scale(1.15); opacity: 0.4; }
      100% { transform: scale(0.95); opacity: 0.8; }
    }
    .whatsapp-pulse {
      animation: pulse-ring 2s infinite ease-in-out;
    }

    /* Custom Scrollbar */
    ::-webkit-scrollbar {
      width: 10px;
    }
    ::-webkit-scrollbar-track {
      background: #121212;
    }
    ::-webkit-scrollbar-thumb {
      background: #374151;
      border-radius: 5px;
    }
    ::-webkit-scrollbar-thumb:hover {
      background: #DC2626;
    }
  </style>
</head>
<body class="bg-brand-black text-gray-100 antialiased selection:bg-brand-red selection:text-white">

  <!-- CONFIGURAÇÕES FACILMENTE PERSONALIZÁVEIS -->
  <script>
    const CONFIG_OFICINA = {
      nome: "AutoTech Centro Automotivo",
      whatsappNumber: "5511999999999", // Número no formato internacional (DDI + DDD + Numero)
      telefone: "(11) 99999-9999",
      endereco: "Av. das Nações Unidas, 1000 - Pinheiros, São Paulo - SP",
      horarioSemana: "Segunda a Sexta: 08h às 18h",
      horarioSabado: "Sábado: 08h às 12h"
    };
  </script>

  <!-- HEADER / CABEÇALHO FIXO -->
  <header class="fixed top-0 left-0 w-full z-50 glass-nav border-b border-brand-border transition-all duration-300">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-20 flex items-center justify-between">
      
      <!-- LOGO -->
      <a href="#inicio" class="flex items-center gap-3 group">
        <div class="w-10 h-10 bg-brand-red rounded-lg flex items-center justify-center text-white text-xl font-black shadow-lg shadow-red-900/40 group-hover:bg-red-700 transition">
          <i class="fa-solid fa-wrench"></i>
        </div>
        <div class="flex flex-col">
          <span class="text-xl font-extrabold tracking-wider uppercase text-white">Auto<span class="text-brand-red">Tech</span></span>
          <span class="text-[10px] text-gray-400 tracking-widest uppercase font-semibold">Centro Automotivo</span>
        </div>
      </a>

      <!-- MENU DESKTOP -->
      <nav class="hidden md:flex items-center gap-8 text-sm font-medium">
        <a href="#inicio" class="hover:text-brand-red transition-colors">Início</a>
        <a href="#servicos" class="hover:text-brand-red transition-colors">Serviços</a>
        <a href="#sobre" class="hover:text-brand-red transition-colors">Sobre Nós</a>
        <a href="#diferenciais" class="hover:text-brand-red transition-colors">Diferenciais</a>
        <a href="#galeria" class="hover:text-brand-red transition-colors">Galeria</a>
        <a href="#avaliacoes" class="hover:text-brand-red transition-colors">Avaliações</a>
        <a href="#contato" class="hover:text-brand-red transition-colors">Contato</a>
      </nav>

      <!-- BOTÃO CTA DESKTOP -->
      <div class="hidden md:flex items-center">
        <a href="#orcamento" class="bg-brand-red hover:bg-brand-redHover text-white px-5 py-2.5 rounded-lg font-semibold text-sm transition-all shadow-md shadow-red-900/30 flex items-center gap-2">
          <i class="fa-brands fa-whatsapp text-lg"></i>
          Solicitar Orçamento
        </a>
      </div>

      <!-- BOTÃO MENU MOBILE -->
      <button id="mobile-menu-btn" class="md:hidden text-gray-300 hover:text-white p-2 focus:outline-none" aria-label="Abrir Menu">
        <i class="fa-solid fa-bars text-2xl"></i>
      </button>
    </div>

    <!-- MENU MOBILE DROPDOWN -->
    <div id="mobile-menu" class="hidden md:hidden bg-brand-dark border-b border-brand-border px-4 pt-2 pb-6 space-y-3">
      <a href="#inicio" class="mobile-link block py-2 border-b border-gray-800/50 hover:text-brand-red">Início</a>
      <a href="#servicos" class="mobile-link block py-2 border-b border-gray-800/50 hover:text-brand-red">Serviços</a>
      <a href="#sobre" class="mobile-link block py-2 border-b border-gray-800/50 hover:text-brand-red">Sobre Nós</a>
      <a href="#diferenciais" class="mobile-link block py-2 border-b border-gray-800/50 hover:text-brand-red">Diferenciais</a>
      <a href="#galeria" class="mobile-link block py-2 border-b border-gray-800/50 hover:text-brand-red">Galeria</a>
      <a href="#avaliacoes" class="mobile-link block py-2 border-b border-gray-800/50 hover:text-brand-red">Avaliações</a>
      <a href="#contato" class="mobile-link block py-2 hover:text-brand-red">Contato</a>
      
      <a href="#orcamento" class="mobile-link mt-4 w-full bg-brand-red text-center text-white py-3 rounded-lg font-bold flex items-center justify-center gap-2">
        <i class="fa-brands fa-whatsapp"></i> Solicitar Orçamento
      </a>
    </div>
  </header>

  <!-- 1. HERO SECTION -->
  <section id="inicio" class="relative min-h-screen flex items-center pt-20 overflow-hidden bg-brand-black">
    <div class="absolute inset-0 z-0">
      <img src="https://images.unsplash.com/photo-1617814076367-b759c7d7e738?auto=format&fit=crop&w=2000&q=80" 
           alt="Oficina Mecânica Profissional" 
           class="w-full h-full object-cover object-center opacity-30 scale-105 transition duration-1000">
      <div class="absolute inset-0 bg-gradient-to-t from-brand-black via-brand-black/70 to-transparent"></div>
      <div class="absolute inset-0 bg-gradient-to-r from-brand-black via-brand-black/80 to-transparent"></div>
    </div>

    <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-20 lg:py-32">
      <div class="max-w-3xl">
        <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-brand-red/10 border border-brand-red/30 text-brand-red text-xs sm:text-sm font-semibold mb-6">
          <i class="fa-solid fa-shield-halved"></i> Centro Especializado Multimarcas
        </div>
        
        <h1 class="text-4xl sm:text-6xl lg:text-7xl font-black text-white leading-tight tracking-tight mb-6">
          Seu carro em <br><span class="text-transparent bg-clip-text bg-gradient-to-r from-brand-red via-red-500 to-amber-500">boas mãos.</span>
        </h1>
        
        <p class="text-lg sm:text-xl text-gray-300 font-normal leading-relaxed mb-8 max-w-2xl">
          Manutenção, diagnóstico e serviços automotivos com qualidade, transparência e confiança.
        </p>

        <div class="flex flex-col sm:flex-row gap-4">
          <a href="#orcamento" class="bg-brand-red hover:bg-brand-redHover text-white px-8 py-4 rounded-xl font-bold text-base transition-all shadow-lg shadow-red-900/40 text-center flex items-center justify-center gap-3">
            <i class="fa-brands fa-whatsapp text-xl"></i>
            Solicitar Orçamento
          </a>
          <a href="#servicos" class="bg-gray-800/80 hover:bg-gray-700 text-gray-200 border border-gray-700 px-8 py-4 rounded-xl font-semibold text-base transition-all text-center flex items-center justify-center gap-2">
            Conhecer Nossos Serviços
            <i class="fa-solid fa-arrow-right text-sm"></i>
          </a>
        </div>

        <div class="mt-12 pt-8 border-t border-gray-800/80 grid grid-cols-2 sm:grid-cols-3 gap-6">
          <div>
            <div class="text-2xl font-bold text-white">100%</div>
            <div class="text-xs text-gray-400">Transparência nos Orçamentos</div>
          </div>
          <div>
            <div class="text-2xl font-bold text-white">Scanner</div>
            <div class="text-xs text-gray-400">Diagnóstico Computadorizado</div>
          </div>
          <div class="col-span-2 sm:col-span-1">
            <div class="text-2xl font-bold text-white">Garantia</div>
            <div class="text-xs text-gray-400">Serviços e Peças Homologadas</div>
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- 2. SERVIÇOS -->
  <section id="servicos" class="py-24 bg-brand-dark relative">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="text-center max-w-3xl mx-auto mb-16">
        <h2 class="text-xs font-bold uppercase tracking-widest text-brand-red mb-2">Especialidades</h2>
        <p class="text-3xl sm:text-4xl font-extrabold text-white">Nossos Serviços Automotivos</p>
        <p class="text-gray-400 mt-4 text-base">Manutenção preventiva e corretiva com tecnologia avançada e diagnósticos precisos.</p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
        
        <!-- Serviço 1 -->
        <div class="glass-card rounded-2xl p-6 transition-all duration-300 flex flex-col justify-between group">
          <div>
            <div class="w-14 h-14 bg-red-950/50 border border-brand-red/30 rounded-xl flex items-center justify-center text-brand-red text-2xl mb-6 group-hover:scale-110 transition-transform">
              <i class="fa-solid fa-clipboard-check"></i>
            </div>
            <h3 class="text-xl font-bold text-white mb-3">Revisão Preventiva</h3>
            <p class="text-gray-400 text-sm leading-relaxed mb-6">Verificação completa dos componentes de segurança do seu carro antes de pegar a estrada.</p>
          </div>
          <a href="#orcamento" onclick="preencherServico('Revisão Preventiva')" class="inline-flex items-center gap-2 text-brand-red hover:text-white font-semibold text-sm transition-colors">
            Solicitar Orçamento <i class="fa-solid fa-chevron-right text-xs"></i>
          </a>
        </div>

        <!-- Serviço 2 -->
        <div class="glass-card rounded-2xl p-6 transition-all duration-300 flex flex-col justify-between group">
          <div>
            <div class="w-14 h-14 bg-red-950/50 border border-brand-red/30 rounded-xl flex items-center justify-center text-brand-red text-2xl mb-6 group-hover:scale-110 transition-transform">
              <i class="fa-solid fa-oil-can"></i>
            </div>
            <h3 class="text-xl font-bold text-white mb-3">Troca de Óleo e Filtros</h3>
            <p class="text-gray-400 text-sm leading-relaxed mb-6">Substituição de lubrificantes e filtros com especificações oficiais da montadora.</p>
          </div>
          <a href="#orcamento" onclick="preencherServico('Troca de Óleo e Filtros')" class="inline-flex items-center gap-2 text-brand-red hover:text-white font-semibold text-sm transition-colors">
            Solicitar Orçamento <i class="fa-solid fa-chevron-right text-xs"></i>
          </a>
        </div>

        <!-- Serviço 3 -->
        <div class="glass-card rounded-2xl p-6 transition-all duration-300 flex flex-col justify-between group">
          <div>
            <div class="w-14 h-14 bg-red-950/50 border border-brand-red/30 rounded-xl flex items-center justify-center text-brand-red text-2xl mb-6 group-hover:scale-110 transition-transform">
              <i class="fa-solid fa-laptop-code"></i>
            </div>
            <h3 class="text-xl font-bold text-white mb-3">Diagnóstico Eletrônico</h3>
            <p class="text-gray-400 text-sm leading-relaxed mb-6">Mapeamento de falhas em injeção eletrônica, ABS e módulos com scanner moderno.</p>
          </div>
          <a href="#orcamento" onclick="preencherServico('Diagnóstico Eletrônico')" class="inline-flex items-center gap-2 text-brand-red hover:text-white font-semibold text-sm transition-colors">
            Solicitar Orçamento <i class="fa-solid fa-chevron-right text-xs"></i>
          </a>
        </div>

        <!-- Serviço 4 -->
        <div class="glass-card rounded-2xl p-6 transition-all duration-300 flex flex-col justify-between group">
          <div>
            <div class="w-14 h-14 bg-red-950/50 border border-brand-red/30 rounded-xl flex items-center justify-center text-brand-red text-2xl mb-6 group-hover:scale-110 transition-transform">
              <i class="fa-solid fa-compact-disc"></i>
            </div>
            <h3 class="text-xl font-bold text-white mb-3">Manutenção de Freios</h3>
            <p class="text-gray-400 text-sm leading-relaxed mb-6">Troca de pastilhas, discos, fluido de freio e verificação do sistema hidráulico.</p>
          </div>
          <a href="#orcamento" onclick="preencherServico('Manutenção de Freios')" class="inline-flex items-center gap-2 text-brand-red hover:text-white font-semibold text-sm transition-colors">
            Solicitar Orçamento <i class="fa-solid fa-chevron-right text-xs"></i>
          </a>
        </div>

        <!-- Serviço 5 -->
        <div class="glass-card rounded-2xl p-6 transition-all duration-300 flex flex-col justify-between group">
          <div>
            <div class="w-14 h-14 bg-red-950/50 border border-brand-red/30 rounded-xl flex items-center justify-center text-brand-red text-2xl mb-6 group-hover:scale-110 transition-transform">
              <i class="fa-solid fa-car-side"></i>
            </div>
            <h3 class="text-xl font-bold text-white mb-3">Suspensão e Direção</h3>
            <p class="text-gray-400 text-sm leading-relaxed mb-6">Troca de amortecedores, molas, buchas, caixa de direção e pivôs.</p>
          </div>
          <a href="#orcamento" onclick="preencherServico('Suspensão e Direção')" class="inline-flex items-center gap-2 text-brand-red hover:text-white font-semibold text-sm transition-colors">
            Solicitar Orçamento <i class="fa-solid fa-chevron-right text-xs"></i>
          </a>
        </div>

        <!-- Serviço 6 -->
        <div class="glass-card rounded-2xl p-6 transition-all duration-300 flex flex-col justify-between group">
          <div>
            <div class="w-14 h-14 bg-red-950/50 border border-brand-red/30 rounded-xl flex items-center justify-center text-brand-red text-2xl mb-6 group-hover:scale-110 transition-transform">
              <i class="fa-solid fa-gears"></i>
            </div>
            <h3 class="text-xl font-bold text-white mb-3">Manutenção de Motores</h3>
            <p class="text-gray-400 text-sm leading-relaxed mb-6">Reparos de correia dentada, junta de cabeçote, embreagem e retífica geral.</p>
          </div>
          <a href="#orcamento" onclick="preencherServico('Manutenção de Motores')" class="inline-flex items-center gap-2 text-brand-red hover:text-white font-semibold text-sm transition-colors">
            Solicitar Orçamento <i class="fa-solid fa-chevron-right text-xs"></i>
          </a>
        </div>

        <!-- Serviço 7 -->
        <div class="glass-card rounded-2xl p-6 transition-all duration-300 flex flex-col justify-between group">
          <div>
            <div class="w-14 h-14 bg-red-950/50 border border-brand-red/30 rounded-xl flex items-center justify-center text-brand-red text-2xl mb-6 group-hover:scale-110 transition-transform">
              <i class="fa-solid fa-temperature-arrow-down"></i>
            </div>
            <h3 class="text-xl font-bold text-white mb-3">Sistema de Arrefecimento</h3>
            <p class="text-gray-400 text-sm leading-relaxed mb-6">Limpeza do radiador, substituição de aditivo, bomba d'água e válvula termostática.</p>
          </div>
          <a href="#orcamento" onclick="preencherServico('Sistema de Arrefecimento')" class="inline-flex items-center gap-2 text-brand-red hover:text-white font-semibold text-sm transition-colors">
            Solicitar Orçamento <i class="fa-solid fa-chevron-right text-xs"></i>
          </a>
        </div>

        <!-- Serviço 8 -->
        <div class="glass-card rounded-2xl p-6 transition-all duration-300 flex flex-col justify-between group">
          <div>
            <div class="w-14 h-14 bg-red-950/50 border border-brand-red/30 rounded-xl flex items-center justify-center text-brand-red text-2xl mb-6 group-hover:scale-110 transition-transform">
              <i class="fa-solid fa-screwdriver-wrench"></i>
            </div>
            <h3 class="text-xl font-bold text-white mb-3">Mecânica Geral</h3>
            <p class="text-gray-400 text-sm leading-relaxed mb-6">Reparos de ignição, escapamentos, baterias, parte elétrica e serviços corretivos.</p>
          </div>
          <a href="#orcamento" onclick="preencherServico('Mecânica Geral')" class="inline-flex items-center gap-2 text-brand-red hover:text-white font-semibold text-sm transition-colors">
            Solicitar Orçamento <i class="fa-solid fa-chevron-right text-xs"></i>
          </a>
        </div>

      </div>
    </div>
  </section>

  <!-- 3. SOBRE A OFICINA -->
  <section id="sobre" class="py-24 bg-brand-black border-t border-brand-border">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
        
        <div class="relative">
          <div class="rounded-2xl overflow-hidden border border-gray-800 shadow-2xl">
            <img src="https://images.unsplash.com/photo-1486006920555-c77dce18193b?auto=format&fit=crop&w=1200&q=80" 
                 alt="Mecânico trabalhando em motor" 
                 class="w-full h-[400px] object-cover hover:scale-105 transition duration-500">
          </div>
          <div class="absolute -bottom-6 -right-6 w-2/3 hidden sm:block rounded-2xl overflow-hidden border-4 border-brand-black shadow-2xl">
            <img src="https://images.unsplash.com/photo-1517524008697-84bbe3c3fd98?auto=format&fit=crop&w=800&q=80" 
                 alt="Elevador de oficina mecânica" 
                 class="w-full h-48 object-cover">
          </div>
        </div>

        <div class="lg:pl-6">
          <h2 class="text-xs font-bold uppercase tracking-widest text-brand-red mb-2">Sobre Nossa Empresa</h2>
          <h3 class="text-3xl sm:text-4xl font-extrabold text-white mb-6">Tecnologia, Transparência e Foco na Sua Segurança</h3>
          
          <p class="text-gray-300 mb-4 leading-relaxed">
            Nossa oficina combina infraestrutura moderna, equipamentos computadorizados e profissionais capacitados para oferecer soluções mecânicas completas para o seu veículo.
          </p>
          
          <p class="text-gray-400 mb-8 leading-relaxed text-sm">
            Trabalhamos com total clareza no orçamento antes de qualquer intervenção, priorizando sempre peças homologadas e a durabilidade dos serviços prestados.
          </p>

          <div class="space-y-4">
            <div class="flex items-start gap-4">
              <div class="w-8 h-8 rounded-lg bg-brand-red/20 text-brand-red flex items-center justify-center shrink-0 mt-1">
                <i class="fa-solid fa-check"></i>
              </div>
              <div>
                <h4 class="text-white font-bold text-sm">Orçamentos Claros</h4>
                <p class="text-gray-400 text-xs">Aprovação prévia sem surpresas na entrega do seu veículo.</p>
              </div>
            </div>

            <div class="flex items-start gap-4">
              <div class="w-8 h-8 rounded-lg bg-brand-red/20 text-brand-red flex items-center justify-center shrink-0 mt-1">
                <i class="fa-solid fa-check"></i>
              </div>
              <div>
                <h4 class="text-white font-bold text-sm">Ferramental Adequado</h4>
                <p class="text-gray-400 text-xs">Diagnósticos por computador e leituras precisas de módulos.</p>
              </div>
            </div>
          </div>

        </div>

      </div>
    </div>
  </section>

  <!-- 4. POR QUE ESCOLHER (DIFERENCIAIS) -->
  <section id="diferenciais" class="py-24 bg-brand-dark">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="text-center max-w-3xl mx-auto mb-16">
        <h2 class="text-xs font-bold uppercase tracking-widest text-brand-red mb-2">Diferenciais</h2>
        <p class="text-3xl sm:text-4xl font-extrabold text-white">Por Que Escolher Nossa Oficina?</p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 lg:grid-cols-5 gap-6">
        
        <div class="bg-brand-black/60 p-6 rounded-2xl border border-gray-800 text-center flex flex-col items-center">
          <div class="w-12 h-12 rounded-full bg-brand-red/10 text-brand-red flex items-center justify-center text-xl mb-4">
            <i class="fa-solid fa-user-check"></i>
          </div>
          <h3 class="text-white font-bold text-base mb-2">Atendimento Personalizado</h3>
          <p class="text-gray-400 text-xs leading-relaxed">Acompanhamento próximo de cada caso com foco na necessidade real.</p>
        </div>

        <div class="bg-brand-black/60 p-6 rounded-2xl border border-gray-800 text-center flex flex-col items-center">
          <div class="w-12 h-12 rounded-full bg-brand-red/10 text-brand-red flex items-center justify-center text-xl mb-4">
            <i class="fa-solid fa-file-invoice-dollar"></i>
          </div>
          <h3 class="text-white font-bold text-base mb-2">Transparência Total</h3>
          <p class="text-gray-400 text-xs leading-relaxed">Detalhamento dos itens trocados e serviços aprovados previamente.</p>
        </div>

        <div class="bg-brand-black/60 p-6 rounded-2xl border border-gray-800 text-center flex flex-col items-center">
          <div class="w-12 h-12 rounded-full bg-brand-red/10 text-brand-red flex items-center justify-center text-xl mb-4">
            <i class="fa-solid fa-microchip"></i>
          </div>
          <h3 class="text-white font-bold text-base mb-2">Equipamentos Adequados</h3>
          <p class="text-gray-400 text-xs leading-relaxed">Uso de aparelhos e ferramentas específicas para cada modelo.</p>
        </div>

        <div class="bg-brand-black/60 p-6 rounded-2xl border border-gray-800 text-center flex flex-col items-center">
